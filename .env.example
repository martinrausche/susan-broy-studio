# =========================================================================
# BROY Instagram Studio - Umgebungsvariablen (.env.example)
#
# Kopieren Sie diese Datei und benennen Sie sie um in: .env.local
# Füllen Sie dann die Werte aus. Committen Sie .env.local NIEMALS in Git!
# =========================================================================

# 1. AUTHENTIFIZIERUNG (Google OAuth & Session-Sicherheit)
# Die beiden Google-E-Mail-Adressen, die Zugriff erhalten sollen (Komma-separiert)
ALLOWED_EMAILS=susanne@example.com,martin@example.com

# Ein zufälliger, geheimer Schlüssel zur Absicherung der Browser-Sessions
JWT_SECRET=super_geheimes_passwort_bitte_aendern_broy_studio_2026!

# Google OAuth Client Credentials (aus der Google Cloud Console)
GOOGLE_CLIENT_ID=ihre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ihr-client-secret

# Redirect URIs
# Für lokale Entwicklung: http://localhost:3000/api/auth/callback
# Für Vercel Production: https://susan-broy-studio.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
